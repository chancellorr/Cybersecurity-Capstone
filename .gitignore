# Allow requirements.txt even if a broader *.txt rule is added later
!requirements.txt

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Secrets and local data (never commit these)
.env
*.db
*.keytab
audit_output/

# Real lab snapshots can contain sensitive data; sample fixtures are allowed
snapshots/
!tests/fixtures/
