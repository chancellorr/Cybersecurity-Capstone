# Append these lines to the repo's existing .gitignore (do not replace the file).
# IMPORTANT: if the existing .gitignore has a rule like *.txt, add the next line
# so requirements.txt is not ignored:
!requirements.txt

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Secrets and local data (never commit these)
.env
*.db
audit_output/

# Real lab snapshots can contain sensitive data; sample fixtures are allowed
snapshots/
!tests/fixtures/